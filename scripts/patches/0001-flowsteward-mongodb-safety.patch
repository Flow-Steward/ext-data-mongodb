--- /dev/null
+++ b/internal/tools/mongodb/mongodbfind/flowsteward_callpath_test.go
@@ -0,0 +1,57 @@
+package mongodbfind
+
+import (
+	"context"
+	"github.com/goccy/go-yaml"
+	"github.com/googleapis/mcp-toolbox/internal/sources"
+	"github.com/googleapis/mcp-toolbox/internal/testutils"
+	"github.com/googleapis/mcp-toolbox/internal/util/parameters"
+	"go.mongodb.org/mongo-driver/v2/mongo"
+	"go.mongodb.org/mongo-driver/v2/mongo/options"
+	"strings"
+	"testing"
+)
+
+type workflowCallSource struct {
+	sources.Source
+	filter, collection string
+	calls              int
+}
+
+func (*workflowCallSource) MongoClient() *mongo.Client { return nil }
+func (s *workflowCallSource) Find(_ context.Context, filter, database, collection string, _ *options.FindOptionsBuilder) ([]any, error) {
+	s.calls++
+	s.filter = filter
+	s.collection = collection
+	return []any{}, nil
+}
+func TestFlowStewardLiteralInvokeCallPath(t *testing.T) {
+	ctx, err := testutils.ContextWithNewLogger()
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoder := yaml.NewDecoder(strings.NewReader(`type: mongodb-find
+source: s
+description: bounded
+collection: fixed
+database: db
+limit: 2
+literalPayload: true
+filterPayload: '{"value":"{{.secret}}"}'
+`))
+	cfg, err := newConfig(ctx, "workflow", decoder)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tool, err := cfg.Initialize(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	source := &workflowCallSource{}
+	if _, err := tool.Invoke(ctx, source, parameters.ParamValues{{Name: "secret", Value: "must-not-expand"}, {Name: "collection", Value: "must-not-select"}}, ""); err != nil {
+		t.Fatal(err)
+	}
+	if source.calls != 1 || source.filter != `{"value":"{{.secret}}"}` || source.collection != "fixed" {
+		t.Fatalf("payload or collection escaped: %d %q %q", source.calls, source.filter, source.collection)
+	}
+}
