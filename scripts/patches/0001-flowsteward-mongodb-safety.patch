+package mongodbfind
+
+import "testing"
+
+func TestFlowStewardLiteralPayload(t *testing.T) {
+	const payload = `{"value":"{{ .secret }}"}`
+	got, err := flowStewardPopulate(true, "literal", payload, map[string]any{"secret": "MUST_NOT_EXPAND"})
+	if err != nil || got != payload {
+		t.Fatalf("literal modified: %q %v", got, err)
+	}
+}
