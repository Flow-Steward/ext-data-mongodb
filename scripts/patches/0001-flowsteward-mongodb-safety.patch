--- /dev/null
+++ b/internal/tools/mongodb/mongodbinsertone/flowsteward_source_test.go
@@ -0,0 +1,20 @@
+package mongodbinsertone_test
+
+import (
+	"context"
+	"github.com/googleapis/mcp-toolbox/internal/sources/mongodb"
+	"github.com/googleapis/mcp-toolbox/internal/tools"
+	"github.com/googleapis/mcp-toolbox/internal/tools/mongodb/mongodbinsertone"
+	"testing"
+)
+
+func TestFlowStewardActualSourceCompatibility(t *testing.T) {
+	cfg := mongodbinsertone.Config{ConfigBase: tools.ConfigBase{Name: "actual-source", Description: "fixed workflow"}, Collection: "fixed"}
+	tool, err := cfg.Initialize(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := tool.ValidateSource(&mongodb.Source{}); err != nil {
+		t.Fatalf("actual managed MongoDB source rejected: %v", err)
+	}
+}
