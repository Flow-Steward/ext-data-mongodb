@@ -0,0 +1,33 @@
+package mongodb
+
+import (
+ "context"
+ "testing"
+ "go.mongodb.org/mongo-driver/v2/bson"
+ "go.mongodb.org/mongo-driver/v2/mongo"
+)
+
+func TestFlowStewardCollectionCursorBounded(t *testing.T) {
+ docs := make([]any, 40)
+ for i := range docs { docs[i] = bson.D{{Key:"name",Value:"items"}} }
+ cur, err := mongo.NewCursorFromDocuments(docs,nil,nil)
+ if err != nil { t.Fatal(err) }
+ rows,err := flowStewardCollectionNames(context.Background(),cur)
+ if err != nil || len(rows) != 33 { t.Fatalf("rows=%d err=%v",len(rows),err) }
+ if cur.ID()!=0 { t.Fatal("metadata cursor not closed") }
+}
+
+func TestFlowStewardCollectionCursorRejectsBadName(t *testing.T) {
+ cur,err := mongo.NewCursorFromDocuments([]any{bson.D{{Key:"name",Value:7}}},nil,nil)
+ if err != nil { t.Fatal(err) }
+ if _,err=flowStewardCollectionNames(context.Background(),cur);err==nil { t.Fatal("invalid name accepted") }
+}
+
+func TestFlowStewardCollectionCursorDoesNotRejectUnsupportedSelectableNames(t *testing.T) {
+ name := ""
+ for i:=0;i<121;i++ { name += "a" }
+ cur,err := mongo.NewCursorFromDocuments([]any{bson.D{{Key:"name",Value:name}},bson.D{{Key:"name",Value:"items"}}},nil,nil)
+ if err!=nil { t.Fatal(err) }
+ rows,err:=flowStewardCollectionNames(context.Background(),cur)
+ if err!=nil || len(rows)!=2 { t.Fatalf("metadata rejected real names: %v %v",rows,err) }
+}
diff --git a/internal/sources/mongodb/flowsteward_policy.go b/internal/sources/mongodb/flowsteward_policy.go
new file mode 100644
index 0000000..e07d1e9
--- /dev/null
+++ b/internal/sources/mongodb/flowsteward_policy.go
@@ -0,0 +1,93 @@
+package mongodb
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"go.mongodb.org/mongo-driver/v2/bson"
+	"go.mongodb.org/mongo-driver/v2/mongo"
+	"net"
+	"net/netip"
+	"time"
+)
+
+var flowStewardReserved = []string{
+	"0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24", "192.168.0.0/16", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "224.0.0.0/4", "240.0.0.0/4",
+	"::/128", "::1/128", "64:ff9b::/96", "64:ff9b:1::/48", "100::/64", "2001::/23", "2001:db8::/32", "2002::/16", "3fff::/20", "fc00::/7", "fe80::/10", "ff00::/8",
+}
+
+func flowStewardAddressAllowed(raw string, tls, allowPrivate bool) error {
+	ip, err := netip.ParseAddr(raw)
+	if err != nil {
+		return fmt.Errorf("invalid destination address")
+	}
+	ip = ip.Unmap()
+	private := !ip.IsGlobalUnicast() || ip.IsPrivate()
+	for _, value := range flowStewardReserved {
+		if netip.MustParsePrefix(value).Contains(ip) {
+			private = true
+			break
+		}
+	}
+	// IPv6 public unicast currently lives in 2000::/3; reject other special ranges.
+	if ip.Is6() && !netip.MustParsePrefix("2000::/3").Contains(ip) {
+		private = true
+	}
+	if private && !allowPrivate {
+		return fmt.Errorf("destination is not a public address")
+	}
+	if !private && !tls {
+		return fmt.Errorf("TLS is required for public destinations")
+	}
+	return nil
+}
+
+type flowStewardDialer struct{ tls, allowPrivate bool }
+
+func (d flowStewardDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil, fmt.Errorf("invalid destination")
+	}
+	addresses, err := net.DefaultResolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, fmt.Errorf("destination lookup failed")
+	}
+	if len(addresses) == 0 {
+		return nil, fmt.Errorf("destination has no addresses")
+	}
+	for _, a := range addresses {
+		if a.Zone != "" {
+			return nil, fmt.Errorf("scoped destination is forbidden")
+		}
+		if err = flowStewardAddressAllowed(a.IP.String(), d.tls, d.allowPrivate); err != nil {
+			return nil, err
+		}
+	}
+	dialer := net.Dialer{Timeout: 10 * time.Second, KeepAlive: 30 * time.Second}
+	for _, a := range addresses {
+		connection, e := dialer.DialContext(ctx, network, net.JoinHostPort(a.IP.String(), port))
+		if e == nil {
+			return connection, nil
+		}
+		err = e
+	}
+	return nil, fmt.Errorf("destination connection failed: %w", err)
+}
+func flowStewardID(id any) any {
+	if id == nil {
+		return nil
+	}
+	encoded, err := bson.MarshalExtJSON(bson.D{{Key: "id", Value: id}}, true, false)
+	if err != nil {
+		return nil
+	}
+	var doc map[string]any
+	if json.Unmarshal(encoded, &doc) != nil {
+		return nil
+	}
+	return doc["id"]
+}
+func flowStewardUpdateResult(result *mongo.UpdateResult) any {
+	return map[string]any{"matched_count": result.MatchedCount, "modified_count": result.ModifiedCount, "upserted_count": result.UpsertedCount, "upserted_id": flowStewardID(result.UpsertedID)}
+}
