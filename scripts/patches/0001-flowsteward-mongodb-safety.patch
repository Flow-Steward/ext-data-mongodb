@@ -0,0 +1,30 @@
+package mongodb
+
+import (
+ "context"
+ "fmt"
+ "go.mongodb.org/mongo-driver/v2/bson"
+ "go.mongodb.org/mongo-driver/v2/mongo"
+ "go.mongodb.org/mongo-driver/v2/mongo/options"
+)
+
+// ListCollections only exposes authorized names from the configured database.
+// The 33rd name is a truncation sentinel, never an unbounded catalog snapshot.
+func (s *Source) ListCollections(ctx context.Context, database string) ([]any,error) {
+ cur,err := s.MongoClient().Database(database).ListCollections(ctx,bson.D{},options.ListCollections().SetNameOnly(true).SetAuthorizedCollections(true).SetBatchSize(1))
+ if err != nil { return nil,err }
+ return flowStewardCollectionNames(ctx,cur)
+}
+
+func flowStewardCollectionNames(ctx context.Context, cur *mongo.Cursor) ([]any,error) {
+ defer cur.Close(ctx)
+ result := []any{}
+ for len(result)<33 && cur.Next(ctx) {
+  var row struct { Name string `bson:"name"` }
+  if err:=cur.Decode(&row);err!=nil { return nil,err }
+  if row.Name=="" || len(row.Name)>4096 { return nil,fmt.Errorf("invalid collection metadata") }
+  result=append(result,map[string]any{"name":row.Name})
+ }
+ if err:=cur.Err();err!=nil { return nil,err }
+ return result,nil
+}
diff --git a/internal/sources/mongodb/flowsteward_collections_test.go b/internal/sources/mongodb/flowsteward_collections_test.go
