--- /dev/null
+++ b/internal/sources/mongodb/flowsteward_policy_test.go
@@ -0,0 +1,49 @@
+package mongodb
+
+import (
+	"go.mongodb.org/mongo-driver/v2/bson"
+	"testing"
+)
+
+func TestFlowStewardAddressPolicy(t *testing.T) {
+	for _, c := range []struct {
+		ip               string
+		tls, private, ok bool
+	}{
+		{"127.0.0.1", false, false, false}, {"127.0.0.1", false, true, true},
+		{"10.1.2.3", true, false, false}, {"10.1.2.3", false, true, true},
+		{"::ffff:127.0.0.1", true, false, false}, {"169.254.169.254", true, false, false},
+		{"192.0.2.1", true, false, false}, {"8.8.8.8", false, true, false},
+		{"8.8.8.8", true, false, true}, {"2606:4700:4700::1111", true, false, true},
+		{"fc00::1", true, false, false}, {"fe80::1", true, false, false},
+	} {
+		if got := flowStewardAddressAllowed(c.ip, c.tls, c.private); (got == nil) != c.ok {
+			t.Errorf("%+v: %v", c, got)
+		}
+	}
+}
+func TestFlowStewardCanonicalIDs(t *testing.T) {
+	if got := flowStewardID(int64(9007199254740993)); got.(map[string]any)["$numberLong"] != "9007199254740993" {
+		t.Fatalf("precision lost: %#v", got)
+	}
+	if got := flowStewardID(nil); got != nil {
+		t.Fatalf("missing ID: %#v", got)
+	}
+}
+
+func TestFlowStewardReadByteLimit(t *testing.T) {
+	if _, _, err := flowStewardReadDocument(make(bson.Raw, flowStewardReadByteLimit+1)); err == nil {
+		t.Fatal("oversized BSON accepted")
+	}
+	raw, err := bson.Marshal(bson.D{{Key: "n", Value: int64(9007199254740993)}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	doc, _, err := flowStewardReadDocument(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if doc.(map[string]any)["n"].(map[string]any)["$numberLong"] != "9007199254740993" {
+		t.Fatalf("precision: %#v", doc)
+	}
+}
